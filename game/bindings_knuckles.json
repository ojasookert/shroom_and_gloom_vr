              "output": "/actions/main/in/Stick"
            },
            "click": {
              "output": "/actions/main/in/Run"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/Stick"
            },
            "click": {
              "output": "/actions/main/in/Recenter"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/Confirm"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/Cancel"
            }
          }
        },
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/SortHand"
            }
          }
        },
        {
          "path": "/user/hand/left/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/Map"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "dpad",
          "parameters": {
            "sub_mode": "click"
          },
          "inputs": {
            "north": {
              "output": "/actions/main/in/NavUp"
            },
            "south": {
              "output": "/actions/main/in/NavDown"
            },
            "west": {
              "output": "/actions/main/in/NavLeft"
            },
            "east": {
              "output": "/actions/main/in/NavRight"
            },
            "center": {
              "output": "/actions/main/in/Inspect"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "dpad",
          "parameters": {
            "sub_mode": "click"
          },
          "inputs": {
            "north": {
              "output": "/actions/main/in/DeckView"
            },
            "south": {
              "output": "/actions/main/in/EndTurn"
            },
            "center": {
              "output": "/actions/main/in/Pause"
            },
            "west": {
              "output": "/actions/main/in/PagePrev"
            },
            "east": {
              "output": "/actions/main/in/PageNext"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/PoseAim",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/main/in/PoseAim",
          "path": "/user/hand/right/pose/tip"
        },
        {
          "output": "/actions/main/in/PoseGrip",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/main/in/PoseGrip",
          "path": "/user/hand/right/pose/raw"
        }
      ],
      "haptics": [
        {
          "output": "/actions/main/out/Haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/main/out/Haptic",
