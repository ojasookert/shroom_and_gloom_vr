{
  "action_manifest_version": 1,
  "alias_info": {},
  "app_key": "steam.app.3271280",
  "category": "steamvr_input",
  "controller_type": "knuckles",
  "description": "Laser on either trigger; left stick walks, right stick turns.",
  "name": "Index default",
  "options": {},
  "simulated_actions": [],
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/main/in/Squeeze"
            },
            "click": {
              "output": "/actions/main/in/Click"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/main/in/Squeeze"
            },
            "click": {
              "output": "/actions/main/in/Click"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/main/in/GripSqueeze"
            },
            "click": {
              "output": "/actions/main/in/Click"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/main/in/GripSqueeze"
            },
            "click": {
              "output": "/actions/main/in/Click"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
